{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransformationInitiative",
  "type": "object",
  "required": ["initiative_id", "name", "business_owner", "status"],
  "properties": {
    "initiative_id": {"type": "string"},
    "name": {"type": "string"},
    "business_owner": {"type": "string"},
    "strategic_theme": {"type": ["string", "null"]},
    "estimated_cost": {"type": ["number", "null"], "minimum": 0},
    "estimated_benefit": {"type": ["number", "null"], "minimum": 0},
    "priority_score": {"type": ["number", "null"]},
    "status": {"type": "string"}
  }
}
